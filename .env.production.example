# Production settings. Set these in your host's secret store, never in git.
NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# Database and photo storage must be inside Ethiopia (Proclamation 1321/2024; confirm with your lawyer)
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/cone
S3_ENDPOINT=https://YOUR-IN-COUNTRY-STORAGE
S3_REGION=us-east-1
S3_BUCKET=cone-photos
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_MEDIA_BASE_URL=https://media.YOURDOMAIN

CORS_ORIGINS=https://YOURDOMAIN,https://www.YOURDOMAIN
# Generate with: openssl rand -hex 32
APP_SECRET=

# Console SMS is refused in production
SMS_PROVIDER=afromessage
SMS_API_KEY=
SMS_SENDER_NAME=Cone
