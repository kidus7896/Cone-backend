# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL. In production this must be an in-Ethiopia database.
DATABASE_URL=postgresql://cone:cone@localhost:5432/cone

# Comma-separated list of frontend origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173

# Random 32+ character secret used to hash tokens and OTP codes
APP_SECRET=change-me-to-a-long-random-string

# S3-compatible object storage for listing photos (in-country in production)
# Photos: "local" saves to the uploads folder (testing). Use "s3" in production.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/media

# SMS / OTP provider. Use "console" in development to print codes to the log.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_NAME=Cone

# Limits
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
